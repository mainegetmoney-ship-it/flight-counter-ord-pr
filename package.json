{
  "name": "flight-counter-ord-pr",
  "version": "1.1.0",
  "description": "Multi-route flight counter for Chicago, Puerto Rico, New York, and Dubai",
  "main": "public/index.html",
  "scripts": {
    "start": "npx -y serve public -p 8080",
    "check": "node --check public/app.js && node --check server/firebase-admin.js",
    "admin:check": "node server/firebase-admin.js",
    "preview": "npx -y firebase-tools emulators:start --only hosting",
    "deploy": "npx -y firebase-tools deploy --only hosting"
  },
  "keywords": [
    "flight-tracker",
    "chicago-ord",
    "puerto-rico-sju",
    "new-york-jfk",
    "dubai-dxb",
    "firebase-hosting"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "firebase-admin": "^13.0.0"
  }
}
